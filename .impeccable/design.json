      "css": ".ds-inspector{font-family:var(--font-body,'Manrope Variable',sans-serif);display:flex;flex-direction:column;gap:6px;font-size:12px;color:#bdbdce;background:#202028;padding:16px}.ds-inspector input{font-family:var(--font-body,'Manrope Variable',sans-serif);border:1px solid #41414f;background:#18181e;color:#e4e4ee;caret-color:#c6c6e4;border-radius:3px;padding:8px;min-width:0;font-size:13px;line-height:1.5}.ds-inspector input:focus-visible{outline:2px solid #c6c6e4;outline-offset:3px;}.ds-inspector input:disabled{cursor:not-allowed}"
