      "html": "<section class=\"ds-script\"><label for=\"ds-script-input\">Script</label><textarea id=\"ds-script-input\" maxlength=\"5000\" placeholder=\"Paste the script you want to turn into motion...\"></textarea></section>",
      "css": ".ds-script{font-family:var(--font-body,'Manrope Variable',sans-serif);background:#1b1b21;border:1px solid #393942;border-radius:10px;overflow:hidden;color:#ececf1}.ds-script label{display:block;font-size:13px;color:#dddde7;padding:18px 20px 0}.ds-script textarea{font-family:var(--font-body,'Manrope Variable',sans-serif);display:block;width:100%;min-height:205px;resize:vertical;border:0;background:transparent;color:#e4e4ed;caret-color:#c6c6e4;padding:18px 20px;font-size:15px;line-height:1.75}.ds-script textarea::placeholder{color:#9393a3}.ds-script textarea:focus-visible{outline:2px solid #c6c6e4;outline-offset:2px}.ds-script textarea:disabled{cursor:not-allowed}"
