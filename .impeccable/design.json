      "css": ".ds-build{font-family:var(--font-body,'Manrope Variable',sans-serif);display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:48px;border:0;border-radius:6px;background:#dddded;color:#1d1d2b;font-size:13px;font-weight:650;cursor:pointer}.ds-build:hover:not(:disabled){background:#ededf8;box-shadow:0 8px 24px #05050933;transform:translateY(-1px)}.ds-build:focus-visible{outline:2px solid #c6c6e4;outline-offset:2px}.ds-build:disabled{background:#363641;color:#9c9cab;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-build{transition:none;animation:none}}"
