      "css": ".ds-scene{font-family:var(--font-body,'Manrope Variable',sans-serif);display:flex;flex-direction:column;align-items:stretch;gap:8px;width:190px;text-align:left;padding:18px 10px;border:0;border-bottom:1px solid #343440;border-radius:0;background:transparent;color:#ececf2;cursor:pointer}.ds-scene[aria-pressed=true]{background:#30303d;outline:1px solid #9292b3;outline-offset:-1px;border-radius:5px}.ds-scene:hover{background:#32323e}.ds-scene:focus-visible{outline:2px solid #c6c6e4;outline-offset:3px;}.ds-scene-time{display:flex;justify-content:space-between;color:#bcbcd6;font-variant-numeric:tabular-nums}.ds-scene strong{font-weight:500;font-size:12px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.ds-scene small{font-size:11px;color:#a6a6b8}"
