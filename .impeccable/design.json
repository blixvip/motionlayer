      "html": "<label class=\"ds-reference\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M16 5h6m-3-3v6M13 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8M3 16l5-5 5 5 3-3 5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>Add a reference image<small>PNG, JPG or WebP · up to 3 MB</small></span><input type=\"file\" accept=\"image/png,image/jpeg,image/webp\" aria-label=\"Color reference image\"/></label>",
      "css": ".ds-reference{font-family:var(--font-body,'Manrope Variable',sans-serif);position:relative;display:flex;align-items:center;gap:12px;border:1px dashed #4b4b59;border-radius:6px;padding:13px;cursor:pointer;color:#c6c6d5;font-size:12px;background:#141418}.ds-reference small{display:block;margin-top:4px;color:#9292a4;font-size:10px}.ds-reference input{position:absolute;inset:0;opacity:0;width:100%;cursor:pointer}.ds-reference:focus-within{outline:2px solid #c6c6e4;outline-offset:3px;}"
    }
